# Node.js 24+. Local development persists to SQLite without credentials.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Leave unset to use SQLite in development and Supabase in production.
# WAITLIST_STORAGE="sqlite"
# WAITLIST_DB_PATH=".data/waitlist.sqlite"

# Required for Supabase (production default). Server-only; never prefix the key with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Studio authentication uses a publishable key, never the secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=""
# Required to encrypt studio BYOK credentials: openssl rand -hex 32
STUDIO_VAULT_KEY=""
# Optional exact trusted studio origin; defaults to the current request origin.
# STUDIO_APP_URL="https://guildos.design"
# Optional Responses API model override.
# STUDIO_OPENAI_MODEL="gpt-4.1-mini"
# Optional ChatGPT device-code bridge. See docs/studio-setup.md before enabling.
# npm run dev configures a local bridge automatically when studio credentials are set.
# These are optional local overrides, or required for a separately hosted bridge.
# CODEX_BRIDGE_URL="http://127.0.0.1:8787"
# CODEX_BRIDGE_TOKEN=""
# Existing legacy service_role JWTs are also supported when SUPABASE_SECRET_KEY is unset.
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional independent HMAC secret. Defaults to the server-only Supabase key.
# WAITLIST_RATE_LIMIT_SECRET=""
# Vercel uses x-vercel-forwarded-for automatically; no header config needed.
# Other hosts: only use a header your reverse proxy overwrites and protects.
# WAITLIST_IP_HEADER="x-real-ip"
