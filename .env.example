# Node.js 24+.
# Required for Supabase. Server-only; never prefix the key with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Studio authentication uses a publishable key, never the secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=""
# Local development only: `npm run dev` applies pending migrations to this database
# before starting. Production is migrated by the GitHub deploy workflow instead.
# Set STUDIO_SKIP_MIGRATIONS=1 to start without migrating.
SUPABASE_DB_URL=""
# Required to encrypt studio BYOK credentials: openssl rand -hex 32
STUDIO_VAULT_KEY=""
# Optional exact trusted studio origin; defaults to the current request origin.
# STUDIO_APP_URL="https://www.guildos.design"
# Optional Responses API model override.
# STUDIO_OPENAI_MODEL="gpt-4.1-mini"

# Free trial: workspaces with no model connection of their own get a few design
# runs on this platform key (Groq takes precedence over OpenRouter). Server-only.
# STUDIO_TRIAL_GROQ_KEY=""
# STUDIO_TRIAL_OPENROUTER_KEY=""
# STUDIO_TRIAL_MODEL=""   # defaults: openai/gpt-oss-120b (Groq) or the free Nemotron model (OpenRouter)
# STUDIO_TRIAL_RUNS="3"   # 0 disables the trial
# The local dev runner starts the AI sign-in service on 127.0.0.1:8787 and generates
# private service/vault secrets under .data. Set the OAuth client after OpenAI issues one.
# OPENAI_CLIENT_ID=""
# OPENAI_CLIENT_SECRET=""
# OPENAI_TOKEN_AUTH_METHOD="none"
# OPENAI_CHATGPT_PLAN_USAGE="enabled" # only after OpenAI grants plan-usage scopes
# Existing legacy service_role JWTs are also supported when SUPABASE_SECRET_KEY is unset.
# SUPABASE_SERVICE_ROLE_KEY=""

# Local development only: npm run dev defaults to codex when OPENAI_CLIENT_ID is absent.
# Production always uses registered OAuth; Codex-managed login is disabled there.
# STUDIO_CHATGPT_AUTH="codex"
# STUDIO_CODEX_BIN="codex"
# STUDIO_CODEX_MODEL=""

# Local development only: shows a "Claude Code" card in Connections that connects your
# signed-in Claude Code CLI (Claude subscription, no API key). Sign in once with `claude` then /login.
# Ignored in production and on non-localhost STUDIO_APP_URL.
# STUDIO_CLAUDE_AUTH="claude-code"
# STUDIO_CLAUDE_CODE_MODEL=""      # e.g. sonnet, opus; empty = Claude Code default
# STUDIO_CLAUDE_CODE_EFFORT=""     # low|medium|high; empty = low for chat, medium for canvas work
# STUDIO_CLAUDE_CODE_BIN="claude"

# Server-only Unsplash application access key for agent image search.
UNSPLASH_ACCESS_KEY=""

# Absolute studio login lifetime; rebuild after changing NEXT_PUBLIC_ settings.
NEXT_PUBLIC_SESSION_MAX_AGE_SECONDS="86400"
# Optional dedicated signing secret (at least 32 random characters).
# Falls back to STUDIO_VAULT_KEY. Never prefix with NEXT_PUBLIC_.
# AUTH_SESSION_SECRET=""
# Optional browser aliases. Existing SUPABASE_URL/PUBLISHABLE_KEY are also supported.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Optional: Claude model for workspaces that connect a Claude API key (default claude-opus-5-5).
# e.g. claude-sonnet-5-5 for lower cost.
# STUDIO_ANTHROPIC_MODEL=""

# Production only (Vercel): shared secret for the hosted worker endpoint /api/worker.
# Store the same value in Supabase Vault as guildos_worker_secret (see docs/studio-setup.md).
# STUDIO_WORKER_SECRET=""
