# Node.js 24+. Local development persists to SQLite without credentials.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Leave unset to use SQLite in development and Supabase in production.
# WAITLIST_STORAGE="sqlite"
# WAITLIST_DB_PATH=".data/waitlist.sqlite"

# Required for Supabase (production default). Server-only; never prefix the key with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Existing legacy service_role JWTs are also supported when SUPABASE_SECRET_KEY is unset.
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional independent HMAC secret. Defaults to the server-only Supabase key.
# WAITLIST_RATE_LIMIT_SECRET=""
# Vercel uses x-vercel-forwarded-for automatically; no header config needed.
# Other hosts: only use a header your reverse proxy overwrites and protects.
# WAITLIST_IP_HEADER="x-real-ip"
