# Node.js 24+. Local development persists to SQLite without credentials.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Leave unset to use SQLite in development and Supabase in production.
# WAITLIST_STORAGE="sqlite"
# WAITLIST_DB_PATH=".data/waitlist.sqlite"

# Required for Supabase (production default). Server-only; never prefix the key with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Studio authentication uses a publishable key, never the secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=""
# Required to encrypt studio BYOK credentials: openssl rand -hex 32
STUDIO_VAULT_KEY=""
# Optional exact trusted studio origin; defaults to the current request origin.
# STUDIO_APP_URL="https://www.guildos.design"
# Optional Responses API model override.
# STUDIO_OPENAI_MODEL="gpt-4.1-mini"
# The local dev runner starts the AI sign-in service on 127.0.0.1:8787 and generates
# private service/vault secrets under .data. Set the OAuth client after OpenAI issues one.
# OPENAI_CLIENT_ID=""
# OPENAI_CLIENT_SECRET=""
# OPENAI_TOKEN_AUTH_METHOD="none"
# OPENAI_CHATGPT_PLAN_USAGE="enabled" # only after OpenAI grants plan-usage scopes
# Existing legacy service_role JWTs are also supported when SUPABASE_SECRET_KEY is unset.
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional independent HMAC secret. Defaults to the server-only Supabase key.
# WAITLIST_RATE_LIMIT_SECRET=""
# Vercel uses x-vercel-forwarded-for automatically; no header config needed.
# Other hosts: only use a header your reverse proxy overwrites and protects.
# WAITLIST_IP_HEADER="x-real-ip"

# Local development only: npm run dev defaults to codex when OPENAI_CLIENT_ID is absent.
# Production always uses registered OAuth; Codex-managed login is disabled there.
# STUDIO_CHATGPT_AUTH="codex"
# STUDIO_CODEX_BIN="codex"
# STUDIO_CODEX_MODEL=""

# Server-only Unsplash application access key for agent image search.
UNSPLASH_ACCESS_KEY=""

# Absolute studio login lifetime; rebuild after changing NEXT_PUBLIC_ settings.
NEXT_PUBLIC_SESSION_MAX_AGE_SECONDS="86400"
# Optional dedicated signing secret (at least 32 random characters).
# Falls back to STUDIO_VAULT_KEY. Never prefix with NEXT_PUBLIC_.
# AUTH_SESSION_SECRET=""
# Optional browser aliases. Existing SUPABASE_URL/PUBLISHABLE_KEY are also supported.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
