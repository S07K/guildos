{
  "name": "guildos",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/ai-signin",
    "packages/provider-auth"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "worker": "node scripts/agent-worker.ts",
    "mcp:icons": "node scripts/icon-mcp.ts",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:studio": "playwright test --config playwright.studio.config.ts",
    "check:supabase": "node scripts/check-supabase.mjs",
    "audit:all": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify": "npm test && npm run build && npm run audit:all && npm run test:e2e"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "bot-avatars": "^0.2.2",
    "gsap": "3.15.0",
    "lucide-react": "^1.57.0",
    "lucide-static": "^0.577.0",
    "next": "16.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@modelcontextprotocol/client": "^2.3.1",
    "@next/env": "16.4.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.23",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3"
  }
}
