{
  "name": "guildos",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/ai-signin",
    "packages/provider-auth"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "worker": "node scripts/agent-worker.ts",
    "db:migrate": "node scripts/migrate.ts",
    "mcp:icons": "node scripts/icon-mcp.ts",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup-env.mjs --test tests/*.test.mjs",
    "test:studio": "playwright test --config playwright.studio.config.ts",
    "audit:all": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify": "npm test && npm run build && npm run audit:all && npm run test:studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "1.6.1",
    "bot-avatars": "^0.2.2",
    "gsap": "3.15.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.73.0",
    "lucide-static": "^0.577.0",
    "next": "16.4.6",
    "prismjs": "^1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@modelcontextprotocol/client": "^2.4.0",
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
